---
import { linkAttrs, profile } from "../data/site";

const nav: { href: string; label: string; file?: boolean }[] = [
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/#elsewhere", label: "Elsewhere" },
  { href: "/#contact", label: "Contact" },
  { href: profile.links.resume, label: "Resume", file: true },
];
---

<header class="site-header">
  <a class="wordmark" href="/">{profile.name}</a>
  <nav aria-label="Sections">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a class:list={{ "nav-resume": item.file }} href={item.href} {...linkAttrs(item.href)}>
              {item.file ? <span>{item.label}</span> : item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
