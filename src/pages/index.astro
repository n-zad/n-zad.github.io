---
import TextLinks from "../components/TextLinks.astro";
import Base from "../layouts/Base.astro";
import {
  additionalProjects,
  everythingPlaylist,
  featuredProjects,
  linkAttrs,
  playlists,
  profile,
  projectLinks,
  projectPath,
} from "../data/site";

const featured = featuredProjects();
const additional = additionalProjects();
const [givenName, familyName] = profile.name.split(" ");

const contactLinks = [
  { label: "Resume", href: profile.links.resume },
  { label: "LinkedIn", href: profile.links.linkedin },
  { label: "GitHub", href: profile.links.github },
];
---

<Base title={profile.name}>
  <header class="hero" id="hero-banner">
    <div class="hero-intro">
      <div class="hero-copy">
        <p class="eyebrow">{profile.location}</p>
        <h1>{givenName}<br />{familyName}</h1>
      </div>
      <img
        class="portrait"
        src="/portrait.jpg"
        alt="Nickzad Bayati"
        width="714"
        height="720"
      />
    </div>
    <p class="lede">
      M.S. student in artificial intelligence at San José State University.
    </p>
    <div class="support">
      <p>
        I got my Bachelor's degree in computer science from Cal Poly San Luis Obispo. Before grad school, I gained software engineering experience through internships at Intel and Solidigm, working on web applications and firmware-release tooling.
      </p>
      <p>
        I'm interested in both building applications with AI and understanding how reliably the models behind them behave. My projects range from AI projects and LLM applications to small apps I build for my own use.
      </p>
    </div>
  </header>

  <section class="band" id="work">
    <div class="section-heading">
      <p class="index">01</p>
      <h2>Selected work</h2>
    </div>
    <ol class="featured-list">
      {
        featured.map((project, position) => (
          <li>
            <p class="project-index">{String(position + 1).padStart(2, "0")}</p>
            <div class="project-copy">
              <h3>
                {project.writeup ? (
                  <a href={projectPath(project)}>{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              <p class="meta">{project.context}</p>
              <p>{project.summary}</p>
              <p class="tags">{project.tags.join(" · ")}</p>
              <TextLinks links={projectLinks(project)} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band band--mist" id="more-work" aria-labelledby="more-work-heading">
    <div class="section-heading">
      <p class="index">02</p>
      <h2 id="more-work-heading">More work</h2>
    </div>
    <ul class="more-list">
      {
        additional.map((project) => (
          <li>
            <div>
              <h3>{project.title}</h3>
              <p class="meta">{project.context}</p>
              <p>{project.summary}</p>
            </div>
            <TextLinks links={project.links} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band" id="about">
    <div class="section-heading">
      <p class="index">03</p>
      <h2>About</h2>
    </div>
    <div class="about-grid">
      <div class="prose">
        <p>
          I studied computer science at Cal Poly San Luis Obispo from 2019 to 2023. In Software Engineering I and II I led backend work on a four-person blogging platform, including the service and data layers, tests, and GitHub Actions. The master's program at San José State runs through 2027.
        </p>
      </div>
      <div class="facts">
        <article>
          <h3>Education</h3>
          <p>M.S. Artificial Intelligence, San José State University, 2025–2027</p>
          <p>B.S. Computer Science, Cal Poly San Luis Obispo, 2019–2023</p>
        </article>
        <article>
          <h3>Solidigm</h3>
          <p class="meta">Product Development Engineering Intern · Jun 2022–Dec 2022 · Rancho Cordova</p>
          <p>
            I worked on Kitting Center, the internal web app in the SSD firmware release process. That included JavaScript features, Python automation for hardware-configuration exports, and updates to a C firmware simulator so it could test current firmware.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--mist" id="elsewhere">
    <div class="section-heading">
      <p class="index">04</p>
      <div>
        <h2>Elsewhere</h2>
        <p class="section-note">
          Music playlists on YouTube, under <a href={profile.links.youtube} {...linkAttrs(profile.links.youtube)}>SrgManatee</a>.
        </p>
      </div>
    </div>
    <ul class="playlist-shelf">
      {
        playlists.map((playlist) => (
          <li>
            <h3>
              <a href={playlist.href} {...linkAttrs(playlist.href)}>
                {playlist.title}
              </a>
            </h3>
            <p class="meta">{playlist.count}</p>
            <p>{playlist.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="playlist-all">
      <a href={everythingPlaylist.href} {...linkAttrs(everythingPlaylist.href)}>
        {everythingPlaylist.label}
      </a>
    </p>
  </section>

  <section class="band band--navy" id="contact">
    <div class="section-heading">
      <p class="index">05</p>
      <h2>Contact</h2>
    </div>
    <p class="contact-email">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <TextLinks links={contactLinks} />
  </section>
</Base>

<script>
  type WaveEffect = {
    destroy: () => void;
  };

  type VantaRuntime = {
    WAVES: (options: {
      el: HTMLElement;
      mouseControls: boolean;
      touchControls: boolean;
      gyroControls: boolean;
      minHeight: number;
      minWidth: number;
      scale: number;
      scaleMobile: number;
      color: number;
      shininess: number;
      waveHeight: number;
      waveSpeed: number;
      zoom: number;
    }) => WaveEffect;
  };

  type VantaWindow = Window & {
    THREE?: unknown;
    VANTA?: VantaRuntime;
  };

  const banner = document.querySelector<HTMLElement>("#hero-banner");
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let waves: WaveEffect | undefined;
  let wavesStarting = false;

  function waveColor(): number {
    const brown = getComputedStyle(document.documentElement).getPropertyValue("--brown").trim();
    const parsed = Number.parseInt(brown.slice(1), 16);
    if (!brown.startsWith("#") || Number.isNaN(parsed)) {
      throw new Error(`Expected --brown to be a hex color, got ${brown}`);
    }
    return parsed;
  }

  function loadScript(src: string): Promise<void> {
    const existing = document.querySelector<HTMLScriptElement>(`script[src="${src}"]`);
    if (existing?.dataset.loaded === "true") {
      return Promise.resolve();
    }

    return new Promise((resolve, reject) => {
      const script = existing ?? document.createElement("script");
      const finish = () => {
        script.dataset.loaded = "true";
        resolve();
      };
      const fail = () => {
        script.remove();
        reject(new Error(`Failed to load ${src}`));
      };
      script.addEventListener("load", finish, { once: true });
      script.addEventListener("error", fail, { once: true });
      if (!existing) {
        script.src = src;
        document.head.appendChild(script);
      }
    });
  }

  async function ensureVanta(): Promise<VantaRuntime> {
    const runtime = window as VantaWindow;
    if (!runtime.THREE) {
      await loadScript("/three.r134.min.js");
    }
    if (!runtime.VANTA) {
      await loadScript("/vanta.waves.min.js");
    }
    if (!runtime.VANTA) {
      throw new Error("Vanta did not register on window");
    }
    return runtime.VANTA;
  }

  function stopWaves() {
    waves?.destroy();
    waves = undefined;
  }

  async function startWaves() {
    if (!banner || motionQuery.matches || waves || wavesStarting || banner.querySelector(".vanta-canvas")) {
      return;
    }

    wavesStarting = true;
    try {
      const vanta = await ensureVanta();
      if (motionQuery.matches || waves || banner.querySelector(".vanta-canvas")) {
        return;
      }
      banner.classList.remove("hero--fallback");
      waves = vanta.WAVES({
        el: banner,
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 200,
        minWidth: 200,
        scale: 1,
        scaleMobile: 1,
        color: waveColor(),
        shininess: 10,
        waveHeight: 8,
        waveSpeed: 2,
        zoom: 0.82,
      });
    } catch (error) {
      banner.classList.add("hero--fallback");
      console.error(error);
    } finally {
      wavesStarting = false;
    }
  }

  motionQuery.addEventListener("change", () => {
    if (motionQuery.matches) {
      stopWaves();
      return;
    }
    void startWaves();
  });

  if (!motionQuery.matches) {
    void startWaves();
  }
</script>
