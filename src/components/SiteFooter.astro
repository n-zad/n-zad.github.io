---
import { linkAttrs, profile } from "../data/site";
---

<footer class="site-footer">
  <a href={`mailto:${profile.email}`}>{profile.email}</a>
  <a href={profile.links.linkedin} {...linkAttrs(profile.links.linkedin)}>LinkedIn</a>
  <a href={profile.links.github} {...linkAttrs(profile.links.github)}>GitHub</a>
  <a href={profile.links.resume} {...linkAttrs(profile.links.resume)}>Resume</a>
</footer>
