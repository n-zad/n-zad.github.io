---
import ContactIcons from "../components/ContactIcons.astro";
import PastProjects from "../components/PastProjects.astro";
import ProjectDialog from "../components/ProjectDialog.astro";
import ProjectSummary from "../components/ProjectSummary.astro";
import TextLinks from "../components/TextLinks.astro";
import { currentProjects, pastProjects, projects } from "../data/projects";
import Base from "../layouts/Base.astro";
import { everythingPlaylist, games, internships, linkAttrs, playlists, profile } from "../data/site";

const current = currentProjects();
const past = pastProjects();
const [givenName, familyName] = profile.name.split(" ");
const videoGames = new Intl.ListFormat("en", { type: "conjunction" }).format(games.video);

const contactLinks = [
  { label: "LinkedIn", href: profile.links.linkedin },
  { label: "GitHub", href: profile.links.github },
];
---

<Base title={profile.name}>
  <header class="hero" id="hero-banner">
    <div class="hero-intro">
      <div class="hero-copy">
        <p class="eyebrow">{profile.location}</p>
        <h1>{givenName}<br />{familyName}</h1>
      </div>
      <div class="hero-portrait">
        <img
          class="portrait"
          src="/portrait.jpg"
          alt="Nickzad Bayati"
          width="714"
          height="720"
        />
        <ContactIcons />
      </div>
    </div>
    <p class="lede">
      M.S. student in artificial intelligence at San José State University.
    </p>
    <div class="support">
      <p>
        I'm interested in both building applications with AI and understanding how reliably the models behind them behave. My projects range from AI projects and LLM applications to small apps I build for my own use.
      </p>
    </div>
  </header>

  <section class="band" id="projects" aria-labelledby="current-projects-heading">
    <div class="section-heading">
      <p class="index">01</p>
      <h2 id="current-projects-heading">Current projects</h2>
    </div>
    <ol class="featured-list">
      {
        current.map((project, position) => (
          <li>
            <p class="project-index">{String(position + 1).padStart(2, "0")}</p>
            <div>
              <ProjectSummary project={project} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="band band--mist" id="past-projects" aria-labelledby="past-projects-heading">
    <div class="section-heading">
      <p class="index">02</p>
      <h2 id="past-projects-heading">Past projects</h2>
    </div>
    <PastProjects projects={past} />
  </section>

  {projects.map((project) => project.details && <ProjectDialog project={project} details={project.details} />)}

  <section class="band" id="about">
    <div class="section-heading">
      <p class="index">03</p>
      <h2>About</h2>
    </div>
    <div class="about-grid">
      <div class="prose">
        <p>
          I'm an AI graduate student at San José State University interested in building software and exploring how AI models behave.
        </p>
        <p>
          I earned my bachelor's degree in computer science from Cal Poly San Luis Obispo. Before grad school, I gained software engineering experience through internships at Intel and Solidigm, working on web applications and firmware-release tooling.
        </p>
        <p>
          In my free time, I enjoy gaming, watching YouTube, browsing Reddit, and listening to music. I'm also a fan of action and comedy shows and movies, and I like vibe coding small tools for my own use.
        </p>
        <TextLinks links={[{ label: "Resume (PDF)", href: profile.links.resume }]} />
      </div>
      <div class="facts">
        <article>
          <h3>Education</h3>
          <p>M.S. Artificial Intelligence, San José State University, 2025–2027</p>
          <p>B.S. Computer Science, Cal Poly San Luis Obispo, 2019–2023</p>
        </article>
        <article>
          <h3>Internships</h3>
          <ul class="internships">
            {
              internships.map((internship) => (
                <li>
                  <h4>{internship.company}</h4>
                  <p class="meta">{internship.role} · {internship.period} · {internship.location}</p>
                  <p>{internship.summary}</p>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--mist" id="interests">
    <div class="section-heading">
      <p class="index">04</p>
      <h2>Interests</h2>
    </div>
    <div class="interest-group">
      <h3>Games</h3>
      <div class="games">
        <article>
          <h4>Video games</h4>
          <p>Lately I've been playing {videoGames}.</p>
        </article>
        <article>
          <h4>Tabletop</h4>
          <p>{games.tabletop}</p>
        </article>
      </div>
    </div>
    <div class="interest-group">
      <h3>Music</h3>
      <p class="section-note">
        Playlists on YouTube, under <a href={profile.links.youtube} {...linkAttrs(profile.links.youtube)}>SrgManatee</a>.
      </p>
      <ul class="playlist-shelf">
        {
          playlists.map((playlist) => (
            <li>
              <h4>
                <a href={playlist.href} {...linkAttrs(playlist.href)}>
                  {playlist.title}
                </a>
              </h4>
              <p class="meta">{playlist.count}</p>
              <p>{playlist.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="playlist-all">
        <a href={everythingPlaylist.href} {...linkAttrs(everythingPlaylist.href)}>
          {everythingPlaylist.label}
        </a>
      </p>
    </div>
  </section>

  <section class="band band--navy" id="contact">
    <div class="section-heading">
      <p class="index">05</p>
      <h2>Contact</h2>
    </div>
    <ul class="contact-primary">
      <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
      <li><a href={profile.phone.href}>{profile.phone.display}</a></li>
    </ul>
    <p class="contact-discord">
      Discord: <strong>{profile.discord.username}</strong> (display name {profile.discord.displayName})
    </p>
    <TextLinks links={contactLinks} />
  </section>
</Base>

<script>
  type WaveEffect = {
    destroy: () => void;
  };

  type VantaRuntime = {
    WAVES: (options: {
      el: HTMLElement;
      mouseControls: boolean;
      touchControls: boolean;
      gyroControls: boolean;
      minHeight: number;
      minWidth: number;
      scale: number;
      scaleMobile: number;
      color: number;
      shininess: number;
      waveHeight: number;
      waveSpeed: number;
      zoom: number;
    }) => WaveEffect;
  };

  type VantaWindow = Window & {
    THREE?: unknown;
    VANTA?: VantaRuntime;
  };

  const banner = document.querySelector<HTMLElement>("#hero-banner");
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  let waves: WaveEffect | undefined;
  let wavesStarting = false;

  function waveColor(): number {
    const brown = getComputedStyle(document.documentElement).getPropertyValue("--brown").trim();
    const parsed = Number.parseInt(brown.slice(1), 16);
    if (!brown.startsWith("#") || Number.isNaN(parsed)) {
      throw new Error(`Expected --brown to be a hex color, got ${brown}`);
    }
    return parsed;
  }

  function loadScript(src: string): Promise<void> {
    const existing = document.querySelector<HTMLScriptElement>(`script[src="${src}"]`);
    if (existing?.dataset.loaded === "true") {
      return Promise.resolve();
    }

    return new Promise((resolve, reject) => {
      const script = existing ?? document.createElement("script");
      const finish = () => {
        script.dataset.loaded = "true";
        resolve();
      };
      const fail = () => {
        script.remove();
        reject(new Error(`Failed to load ${src}`));
      };
      script.addEventListener("load", finish, { once: true });
      script.addEventListener("error", fail, { once: true });
      if (!existing) {
        script.src = src;
        document.head.appendChild(script);
      }
    });
  }

  async function ensureVanta(): Promise<VantaRuntime> {
    const runtime = window as VantaWindow;
    if (!runtime.THREE) {
      await loadScript("/three.r134.min.js");
    }
    if (!runtime.VANTA) {
      await loadScript("/vanta.waves.min.js");
    }
    if (!runtime.VANTA) {
      throw new Error("Vanta did not register on window");
    }
    return runtime.VANTA;
  }

  function stopWaves() {
    waves?.destroy();
    waves = undefined;
  }

  async function startWaves() {
    if (!banner || motionQuery.matches || waves || wavesStarting || banner.querySelector(".vanta-canvas")) {
      return;
    }

    wavesStarting = true;
    try {
      const vanta = await ensureVanta();
      if (motionQuery.matches || waves || banner.querySelector(".vanta-canvas")) {
        return;
      }
      banner.classList.remove("hero--fallback");
      waves = vanta.WAVES({
        el: banner,
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 200,
        minWidth: 200,
        scale: 1,
        scaleMobile: 1,
        color: waveColor(),
        shininess: 10,
        waveHeight: 8,
        waveSpeed: 2,
        zoom: 0.82,
      });
    } catch (error) {
      banner.classList.add("hero--fallback");
      console.error(error);
    } finally {
      wavesStarting = false;
    }
  }

  motionQuery.addEventListener("change", () => {
    if (motionQuery.matches) {
      stopWaves();
      return;
    }
    void startWaves();
  });

  if (!motionQuery.matches) {
    void startWaves();
  }
</script>
